# ----------------------------------------------------------------------
# Financial Risk Intelligence System — environment configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit or share the real .env file (it is git-ignored).
# ----------------------------------------------------------------------

# Which LLM provider the AI Risk Investigation Agent uses:
#   google    -> Google Gemini  (free student tier — what we use)
#   anthropic -> Anthropic Claude
LLM_PROVIDER=google

# --- Google Gemini (free tier) ---
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# Model to use. Pick one your key can access (list them with the snippet in
# the README "Choosing a Gemini model" section). Good free-tier choices:
#   gemini-flash-latest, gemini-3.1-flash-lite, gemini-3-flash-preview
# NOTE: each model has its OWN daily free-tier quota (~500 requests/day),
# and there is a per-minute cap (~15/min). See the README for details.
GEMINI_MODEL=gemini-flash-latest

# --- Anthropic Claude (only used if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-haiku-20241022

# How many of the highest-risk transactions to investigate.
#   0 = no cap (process ALL flagged Medium/High transactions — ~506).
AGENT_MAX_TRANSACTIONS=0

# Force the offline template agent regardless of keys (true/false).
#   true -> zero API calls, deterministic evidence-based output.
AGENT_FORCE_OFFLINE=false

# Seconds to wait between LLM calls to respect free-tier rate limits.
# Gemini free tier is ~15 requests/min, so ~4.5s spacing is safe.
AGENT_REQUEST_INTERVAL=4.5
